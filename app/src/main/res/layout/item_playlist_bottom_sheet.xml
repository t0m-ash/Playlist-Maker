<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/track_item_min_height"
    android:paddingStart="@dimen/track_item_padding_start"
    android:paddingEnd="@dimen/track_item_padding_end"
    android:paddingVertical="@dimen/track_item_padding_vertical">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/playlistCover"
        android:layout_width="@dimen/track_artwork_size"
        android:layout_height="@dimen/track_artwork_size"
        android:contentDescription="@string/playlist_cover_description"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_playlist_placeholder"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Playlist.SmallCover" />

    <TextView
        android:id="@+id/playlistName"
        style="@style/TrackNameStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/track_artwork_margin_end"
        app:layout_constraintBottom_toTopOf="@id/playlistTracksCount"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/playlistCover"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="Best songs 2021" />

    <TextView
        android:id="@+id/playlistTracksCount"
        style="@style/TrackSubtitleStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/track_artwork_margin_end"
        android:layout_marginTop="@dimen/track_text_spacing"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/playlistCover"
        app:layout_constraintTop_toBottomOf="@id/playlistName"
        tools:text="98 треков" />

</androidx.constraintlayout.widget.ConstraintLayout>
