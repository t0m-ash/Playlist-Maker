<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/playlist_grid_item_margin_horizontal"
    android:layout_marginBottom="@dimen/playlist_grid_item_margin_bottom">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/playlistCover"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/playlist_cover_description"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_playlist_placeholder"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Playlist.Cover" />

    <TextView
        android:id="@+id/playlistName"
        style="@style/PlaylistGridInfoStyle"
        android:layout_marginTop="@dimen/playlist_grid_info_margin_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/playlistCover"
        tools:text="Best songs 2021" />

    <TextView
        android:id="@+id/playlistTracksCount"
        style="@style/PlaylistGridInfoStyle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/playlistName"
        tools:text="98 треков" />

</androidx.constraintlayout.widget.ConstraintLayout>
