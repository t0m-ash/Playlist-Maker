<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="SwitchStyle">
        <item name="thumbTint">@color/blue</item>
        <item name="trackTint">@color/blue_light</item>
    </style>

    <style name="TextViewSettingsStyle">
        <item name="android:textColor">@color/text_black</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">@dimen/text_size_16</item>
        <item name="android:textFontWeight">400</item>
    </style>

    <style name="ImageButtonSettingsStyle">
        <item name="android:layout_width">@dimen/ib_width_24</item>
        <item name="android:layout_height">@dimen/ib_height_24</item>
        <item name="android:backgroundTint">@android:color/transparent</item>
    </style>

    <style name="TopBarStyle">
        <item name="android:textColor">@color/black</item>
        <item name="android:layout_height">@dimen/bar_56</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textSize">@dimen/text_size_22</item>
    </style>

    <style name="TopBarTitleStyle" parent="TopBarStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">@dimen/top_bar_title_margin_start</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textSize">@dimen/text_size_22</item>
    </style>

    <style name="TopBarIconButtonStyle" parent="TopBarStyle">
        <item name="android:layout_width">@dimen/ib_with_48</item>
        <item name="android:layout_height">@dimen/ib_height_48dp</item>
        <item name="android:layout_margin">@dimen/ib_bar_margin_4</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="SearchBarContainerStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">@dimen/search_field_margin_horizontal</item>
        <item name="android:layout_marginVertical">@dimen/search_field_margin_vertical</item>
    </style>

    <style name="SearchBarEditTextStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/search_field_height</item>
        <item name="android:background">@drawable/search_bar</item>
        <item name="android:drawableStart">@drawable/ic_search_16</item>
        <item name="android:drawablePadding">@dimen/search_field_drawable_padding</item>
        <item name="android:inputType">text</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">@dimen/search_field_padding_start</item>
        <item name="android:paddingEnd">@dimen/search_field_padding_end</item>
        <item name="android:textCursorDrawable">@drawable/cursor_blue</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorHint">@color/text_gray</item>
        <item name="android:drawableTint">@color/text_gray</item>
    </style>

    <style name="SearchBarClearIconStyle">
        <item name="android:layout_width">@dimen/clear_icon_width</item>
        <item name="android:layout_height">@dimen/clear_icon_height</item>
        <item name="android:layout_gravity">end|center_vertical</item>
        <item name="android:paddingHorizontal">@dimen/clear_icon_padding_horizontal</item>
        <item name="android:paddingVertical">@dimen/clear_icon_padding_vertical</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="TrackNameStyle">
        <item name="android:textColor">@color/track_title</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">@dimen/text_size_16</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="TrackSubtitleStyle">
        <item name="android:textColor">@color/track_subtitle</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">@dimen/text_size_11</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="PlaceholderMessageStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/track_title</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">@dimen/text_size_19</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="SearchHistoryTitleStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/track_title</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">@dimen/text_size_19</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="ShapeAppearanceOverlay.Player.Cover" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/player_cover_corner_radius</item>
    </style>

    <style name="PlayerTrackNameStyle">
        <item name="android:textColor">@color/track_title</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">@dimen/text_size_22</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="PlayerArtistNameStyle">
        <item name="android:textColor">@color/track_title</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">@dimen/text_size_14</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="PlayerProgressStyle">
        <item name="android:textColor">@color/track_title</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">@dimen/text_size_14</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <style name="PlayerInfoLabelStyle">
        <item name="android:textColor">@color/text_gray</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">@dimen/text_size_13</item>
        <item name="android:textFontWeight">400</item>
    </style>

    <style name="PlayerInfoValueStyle">
        <item name="android:textColor">@color/track_title</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">@dimen/text_size_13</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">end</item>
    </style>

    <style name="ActionButtonStyle" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:backgroundTint">@color/action_button_background</item>
        <item name="android:textColor">@color/action_button_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">@dimen/text_size_14</item>
        <item name="android:paddingHorizontal">@dimen/refresh_button_padding_horizontal</item>
        <item name="cornerRadius">@dimen/main_btn_radius_16</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <style name="SearchProgressBarStyle" parent="Widget.AppCompat.ProgressBar">
        <item name="android:layout_width">@dimen/search_progress_size</item>
        <item name="android:layout_height">@dimen/search_progress_size</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:layout_marginTop">@dimen/search_progress_margin_top</item>
        <item name="android:indeterminateTint">@color/blue</item>
    </style>

    <style name="LibraryTabLayoutStyle" parent="Widget.MaterialComponents.TabLayout">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/library_tab_height</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="elevation">0dp</item>
        <item name="tabMode">fixed</item>
        <item name="tabGravity">fill</item>
        <item name="tabTextColor">@color/tab_text</item>
        <item name="tabSelectedTextColor">@color/tab_text</item>
        <item name="tabIndicator">@drawable/tab_indicator</item>
        <item name="tabIndicatorColor">@color/tab_indicator</item>
        <item name="tabIndicatorHeight">@dimen/library_tab_indicator_height</item>
        <item name="tabIndicatorFullWidth">true</item>
        <item name="tabRippleColor">@null</item>
        <item name="tabTextAppearance">@style/LibraryTabTextAppearance</item>
    </style>

    <style name="LibraryTabTextAppearance" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">@dimen/text_size_14</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="BottomNavigationViewStyle" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/bottom_navigation_height</item>
        <item name="android:background">@color/bottom_navigation_background</item>
        <item name="elevation">0dp</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemIconSize">@dimen/bottom_navigation_icon_size</item>
        <item name="itemIconTint">@color/bottom_navigation_item_color</item>
        <item name="itemTextColor">@color/bottom_navigation_item_color</item>
        <item name="itemTextAppearanceActive">@style/BottomNavigationTextAppearance</item>
        <item name="itemTextAppearanceInactive">@style/BottomNavigationTextAppearance</item>
        <item name="itemRippleColor">@null</item>
        <item name="menu">@menu/bottom_navigation_menu</item>
    </style>

    <style name="BottomNavigationTextAppearance" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">@dimen/text_size_12</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="NewPlaylistButtonStyle" parent="ActionButtonStyle">
        <item name="android:layout_height">@dimen/library_new_playlist_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/library_new_playlist_radius</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="ShapeAppearanceOverlay.Playlist.Cover" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/playlist_cover_corner_radius</item>
    </style>

    <style name="ShapeAppearanceOverlay.Playlist.SmallCover" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/track_artwork_corner_radius</item>
    </style>

    <style name="PlaylistGridInfoStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/track_title</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">@dimen/text_size_12</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:lineHeight">@dimen/playlist_grid_info_line_height</item>
        <item name="android:letterSpacing">0.0333</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="BottomSheetTitleStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/track_title</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">@dimen/text_size_19</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:lineHeight">@dimen/bottom_sheet_title_line_height</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="PlaylistTextFieldStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/text_field_stroke_color</item>
        <item name="boxStrokeWidth">@dimen/new_playlist_field_stroke_width</item>
        <item name="boxStrokeWidthFocused">@dimen/new_playlist_field_stroke_width</item>
        <item name="boxCornerRadiusTopStart">@dimen/new_playlist_field_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/new_playlist_field_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/new_playlist_field_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/new_playlist_field_corner_radius</item>
        <item name="android:textColorHint">@color/text_field_hint</item>
        <item name="hintTextColor">@color/text_field_label</item>
        <item name="hintTextAppearance">@style/PlaylistTextFieldLabelAppearance</item>
    </style>

    <style name="PlaylistTextFieldLabelAppearance" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/text_field_label</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">@dimen/text_size_12</item>
        <item name="android:letterSpacing">0.0333</item>
    </style>

    <style name="PlaylistEditTextStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">@dimen/text_size_16</item>
        <item name="android:textColor">@color/track_title</item>
        <item name="android:textCursorDrawable">@drawable/cursor_blue</item>
        <item name="android:inputType">textCapSentences</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="CreatePlaylistButtonStyle" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_height">@dimen/new_playlist_create_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/create_playlist_button_background</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">@dimen/text_size_16</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">@dimen/new_playlist_create_corner_radius</item>
    </style>

    <style name="ThemeOverlay.PlaylistMaker.MaterialAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/blue</item>
    </style>

    <style name="PlaylistTitleStyle">
        <item name="android:textColor">@color/playlist_screen_content</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_size_24</item>
        <item name="android:lineHeight">@dimen/playlist_title_line_height</item>
    </style>

    <style name="PlaylistInfoStyle">
        <item name="android:textColor">@color/playlist_screen_content</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">@dimen/text_size_18</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:lineHeight">@dimen/playlist_info_line_height</item>
    </style>

    <style name="PlaylistActionButtonStyle">
        <item name="android:layout_width">@dimen/playlist_action_size</item>
        <item name="android:layout_height">@dimen/playlist_action_size</item>
        <item name="android:padding">@dimen/playlist_action_padding</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">@color/playlist_screen_content</item>
    </style>

    <style name="PlaylistMenuItemStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/playlist_menu_item_height</item>
        <item name="android:paddingHorizontal">@dimen/playlist_menu_item_padding_horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:textColor">@color/track_title</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">@dimen/text_size_16</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>